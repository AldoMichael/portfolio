# --- Base de données PostgreSQL ---
# Hébergeur managé (Neon, Railway, Render…) : renseigner UNIQUEMENT cette ligne.
# Elle a la priorité sur les variables DB_* ci-dessous.
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require

# Base distante visée par « npm run db:setup » (via HTTPS, port 443).
# Utile si le port 5432 est bloqué sur votre réseau : l'API locale reste alors
# sur PostgreSQL en local pendant que le schéma est créé à distance.
# NEON_DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require

# Connexion locale, utilisée si DATABASE_URL est absente
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=motdepasse
DB_NAME=portfolio
# Laisser à true en développement : TypeORM crée les tables automatiquement.
DB_SYNCHRONIZE=true
DB_LOGGING=false
# Taille max du pool de connexions (à garder basse en serverless)
DB_POOL_MAX=5

# --- API ---
PORT=3001
# Origines autorisées à appeler l'API (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- Authentification de l'administration ---
# Générer une clé aléatoire : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Compte créé/mis à jour par « npm run seed »
ADMIN_EMAIL=randriantsoamanitramichael1@gmail.com
ADMIN_PASSWORD=changez-moi
